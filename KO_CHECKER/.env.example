# Copy to .env to move the folders to a larger disk (move existing data first, then restart).
# References (FASTA, GTF, HISAT2 index) can be shared with TES_Checker / TE_Checker.
KO_REFERENCES_DIR=/mnt/gifft-data/TES_Checker/references
KO_DATA_DIR=/mnt/gifft-data/KO_Checker/workdata
KO_RESULTS_DIR=/mnt/gifft-data/KO_Checker/results
# Folder with your own BAM files for the CLI (mounted read-only at /data).
# RNAKO_DATA_DIR=/path/to/Analysis_parent
